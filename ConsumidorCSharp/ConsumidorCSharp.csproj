<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ConsumidorCSharp</AssemblyName>
  </PropertyGroup>

  <!-- Copia el secret.dll (de la carpeta padre) junto al .exe para que P/Invoke lo encuentre -->
  <ItemGroup>
    <None Include="..\secret.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
